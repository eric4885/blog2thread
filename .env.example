# APIMart (OpenAI-compatible). Get key from https://apimart.ai console.
OPENAI_API_KEY=your_apimart_api_key
OPENAI_BASE_URL=https://api.apimart.ai/v1
# Optional model override (must be supported by APIMart)
OPENAI_MODEL=gpt-4o-mini
# Google Analytics 4 (optional). Build-time: set in Cloudflare + rebuild.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional local proxy only if your network needs it
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809
